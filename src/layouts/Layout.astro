---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Tyler Irving | Full-Stack Software Engineer',
  description = 'Tyler Irving — Full-Stack Software Engineer with an active U.S. Secret Clearance. Currently building UiPath automation for the U.S. Navy at Baker Tilly, plus AI/ML tools and full-stack apps in Python, TypeScript, React, and Django.',
  image = '/images/og-image.png',
  canonical,
} = Astro.props;

const siteUrl = 'https://tyler-irving.github.io';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Charset & Viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Tyler Irving, Full-Stack Software Engineer, Python developer, TypeScript, React developer, Django developer, Next.js, full-stack developer, AI engineer, Claude API, Anthropic, Model Context Protocol, MCP, RAG, QLoRA, RPA developer, UiPath, Automation Consultant, Secret Security Clearance, Baker Tilly, U.S. Navy, portfolio, software engineer, automation systems"
    />
    <meta name="author" content="Tyler Irving" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tyler Irving" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@TylerIrving" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#FAFAFA" />
    <meta name="color-scheme" content="light dark" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Fonts — Google Fonts (Archivo + Space Grotesk + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <!-- Dark mode init — light is default; only go dark if user explicitly toggled -->
    <script is:inline>
      (function () {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Structured Data: Person -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Tyler Irving",
        "url": "https://tyler-irving.github.io",
        "image": "https://tyler-irving.github.io/assets/tyler-irving.jpg",
        "jobTitle": "Full-Stack Software Engineer",
        "description": "Full-Stack Software Engineer with an active US Secret Clearance, currently building UiPath automation for the U.S. Navy at Baker Tilly, plus AI/ML tools and full-stack web applications in Python, TypeScript, React, and Django.",
        "worksFor": {
          "@type": "Organization",
          "name": "Baker Tilly",
          "url": "https://www.bakertilly.com"
        },
        "hasOccupation": {
          "@type": "Occupation",
          "name": "Full-Stack Software Engineer",
          "occupationLocation": {
            "@type": "Country",
            "name": "United States"
          },
          "skills": "Python, TypeScript, React, Django, FastAPI, PostgreSQL, Docker, Google Cloud Platform, Claude API, Model Context Protocol, Retrieval-Augmented Generation, UiPath, Robotic Process Automation, Full-Stack Development"
        },
        "sameAs": [
          "https://github.com/Tyler-Irving",
          "https://www.linkedin.com/in/tyler-irving-94b567189/"
        ],
        "knowsAbout": [
          "Robotic Process Automation",
          "UiPath Studio",
          "UiPath Orchestrator",
          "UiPath AI Center",
          "Document Understanding",
          "Python",
          "Django",
          "Django REST Framework",
          "React",
          "TypeScript",
          "Full-Stack Development",
          "Software Engineering",
          "Automation Systems",
          "Machine Learning",
          "Claude API",
          "Anthropic",
          "Model Context Protocol",
          "Retrieval-Augmented Generation",
          "QLoRA Fine-Tuning",
          "Enterprise Automation",
          "U.S. Navy",
          "Secret Security Clearance"
        ],
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "Base Camp Coding Academy",
            "url": "https://www.basecampcodingacademy.org"
          },
          {
            "@type": "HighSchool",
            "name": "Hernando High School"
          }
        ]
      }
    </script>

    <!-- Structured Data: Portfolio Projects -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Tyler Irving — Portfolio Projects",
        "description": "Software projects built by Tyler Irving: AI/ML tools, an MCP server, and a full-stack cloud-infrastructure web app.",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "SoftwareApplication",
              "name": "garmin-mcp",
              "url": "https://pypi.org/project/garmin-mcp/",
              "description": "Open-source Model Context Protocol (MCP) server, published on PyPI, exposing Garmin Connect health data to Claude as typed tools, with a self-hostable OAuth 2.1 layer for Claude.ai custom connectors.",
              "applicationCategory": "DeveloperApplication",
              "author": { "@type": "Person", "name": "Tyler Irving" }
            }
          },
          {
            "@type": "ListItem",
            "position": 2,
            "item": {
              "@type": "SoftwareApplication",
              "name": "motor-pool",
              "url": "https://github.com/Tyler-Irving/motor-pool",
              "description": "Grounded AI diagnostic assistant over public U.S. Army HMMWV technical manuals. Hybrid retrieval (BM25 + dense embeddings with reciprocal rank fusion) and a QLoRA-fine-tuned model that cites manual sections, returns structured procedures, and refuses out-of-scope questions.",
              "applicationCategory": "DeveloperApplication",
              "author": { "@type": "Person", "name": "Tyler Irving" }
            }
          },
          {
            "@type": "ListItem",
            "position": 3,
            "item": {
              "@type": "WebApplication",
              "name": "Where is my data?",
              "url": "https://whereismydata.io",
              "description": "Interactive globe visualizing 181 cloud and colocation datacenters across 43 providers. Latency estimation, pricing comparison, and CSV/JSON export.",
              "applicationCategory": "DeveloperApplication",
              "author": { "@type": "Person", "name": "Tyler Irving" }
            }
          }
        ]
      }
    </script>
  </head>

  <body>
    <slot />
  </body>

</html>
