---
import ProjectCard from './ProjectCard.astro';

const featuredIds = new Set(['where-is-my-data']);

const projects = [
  {
    id: 'garmin-mcp',
    title: 'garmin-mcp',
    icon: '⌚',
    oneliner: 'An MCP server on PyPI that hands your Garmin Connect health data to Claude as typed tools — with a full OAuth 2.1 layer for custom connectors.',
    description:
      'Open-source Model Context Protocol (MCP) server, published on PyPI, that exposes Garmin Connect health & fitness data to Claude as typed tools — sleep, HRV, training load, body battery, and more — read-only by default, with an opt-in tool to build strength workouts. Self-hostable HTTP mode implements a full OAuth 2.1 layer with PKCE and Dynamic Client Registration so Claude.ai custom connectors can authenticate; Pydantic response models throughout, deployable to Google Cloud Run via Docker.',
    tech: ['Python', 'FastMCP', 'Model Context Protocol', 'OAuth 2.1 (PKCE)', 'Pydantic', 'Docker', 'Cloud Run', 'PyPI'],
    github: 'https://github.com/Tyler-Irving/garmin-mcp',
    liveUrl: 'https://pypi.org/project/garmin-mcp/',
    stats: [
      { label: 'Distribution', value: 'PyPI' },
      { label: 'Auth', value: 'OAuth 2.1' },
      { label: 'Deploy', value: 'Cloud Run' },
    ],
    decisions: [
      'Published to PyPI as an installable MCP server — typed tools for sleep, HRV, training load, body battery and more Garmin Connect metrics',
      'Read-only by default; building workouts is an explicit opt-in tool — safe to connect without write access to your account',
      'Self-hostable HTTP mode implements OAuth 2.1 with PKCE + Dynamic Client Registration so Claude.ai custom connectors authenticate cleanly',
      'Pydantic response models throughout, Dockerized for one-command deploy to Google Cloud Run',
    ],
    footer: 'Open source · MCP · on PyPI',
  },
  {
    id: 'motor-pool',
    title: 'motor-pool',
    icon: '🛠️',
    oneliner: 'A grounded AI assistant over public HMMWV Army manuals — it cites the manual, returns structured procedures, and refuses anything out of scope.',
    description:
      'Grounded AI diagnostic assistant over public-domain U.S. Army Technical Manuals for the HMMWV (materiel/maintenance domain). Hybrid retrieval — BM25 lexical search fused with dense embeddings via reciprocal rank fusion — feeds a QLoRA-fine-tuned model that cites the exact manual sections it used, returns structured maintenance procedures, and refuses out-of-scope questions instead of hallucinating. Shipped with an honest evaluation harness: on a frozen 136-item eval set, schema-valid output rose from 52% to 90% and refusal F1 from 14% to 90% versus the base model.',
    tech: ['Python', 'Pydantic', 'bm25s', 'Dense embeddings', 'Reciprocal Rank Fusion', 'QLoRA', 'Unsloth', 'TRL'],
    github: 'https://github.com/Tyler-Irving/motor-pool',
    stats: [
      { label: 'Schema-Valid', value: '52→90%' },
      { label: 'Refusal F1', value: '14→90%' },
      { label: 'Eval Items', value: '136' },
    ],
    decisions: [
      'Hybrid retrieval — BM25 lexical + dense embeddings fused with reciprocal rank fusion (RRF) for robust recall over dense technical-manual language',
      'Behavior-only QLoRA fine-tune (Unsloth + TRL) teaches citation, structured procedure output, and out-of-scope refusal — without memorizing the manuals',
      'Frozen 136-item eval set as ground truth: schema-valid output 52%→90%, refusal F1 14%→90% vs. the base model — improvements are measured, not asserted',
      'Pydantic-validated outputs — every answer is a typed, schema-checked procedure that cites its source sections, not free text',
    ],
    footer: 'Open source · AI / retrieval',
  },
  {
    id: 'where-is-my-data',
    title: 'Where is my data?',
    icon: '🔍',
    oneliner: '181 datacenters. 43 cloud providers. Latency estimation. All on one map.',
    description:
      'Interactive globe visualizing 181 cloud and colocation datacenters across AWS, Azure, GCP, Equinix, Digital Realty, Cloudflare, and 40+ other providers. Filter by provider type, estimate round-trip latency with a Haversine + fiber routing model, compare cloud pricing across 33 regions, and export filtered results as CSV or JSON.',
    tech: ['Next.js 16', 'React 19', 'TypeScript', 'Mapbox GL JS', 'Zustand', 'Tailwind CSS 4', 'Vercel'],
    github: 'https://github.com/Tyler-Irving/where-is-my-data',
    liveUrl: 'https://whereismydata.io',
    stats: [
      { label: 'Datacenters', value: '181' },
      { label: 'Providers', value: '43' },
      { label: 'Pricing Regions', value: '33' },
    ],
    decisions: [
      'Zustand with 6 stores (datacenter, filter, map, comparison, latency, pricing) — no Redux boilerplate',
      'Latency uses Haversine + 1.3x fiber overhead + hop decay + 15% congestion buffer — fully offline, no live ping',
      'Uncontrolled Mapbox pattern — flyTo/setMaxBounds called imperatively via mapRef to avoid animation choppiness',
      'Shareable URLs via custom useUrlSync hook with 500ms debounce — encodes filters, viewport, and selected datacenter into query params',
    ],
    footer: 'Deployed on Vercel | 2026',
  },
] as const;
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Selected Work</h2>
      <span class="section-count label-mono">[ 01 — 03 ]</span>
    </div>

    <div class="projects-grid">
      {
        projects.map((project, i) => (
          <div class={`grid-item${featuredIds.has(project.id) ? ' grid-item--full' : ''}`}>
            <ProjectCard {...project} index={i + 1} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding-block: var(--section-gap);
  }

  /* Grid layout */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* Featured card spans full width */
  .grid-item--full {
    grid-column: 1 / -1;
  }

  /* All other items: normal column span */
  .grid-item {
    display: flex;
    flex-direction: column;
  }

  /* Make the card fill its grid cell height */
  .grid-item > :global(.project-card) {
    flex: 1;
  }

  /* Responsive: single column on mobile */
  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .grid-item--full {
      grid-column: 1;
    }
  }
</style>
